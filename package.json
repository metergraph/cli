{
  "name": "metergraph-cli",
  "version": "0.2.3",
  "description": "Metergraph command line tool with a read-only connection probe, a project skill installer, Metadata-only sign in and bounded workspace Metadata reads",
  "type": "module",
  "bin": {
    "metergraph": "bin/metergraph.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin/metergraph.js",
    "src/*.js",
    "native/anchored-fs.c",
    "native/build.mjs",
    "native/targets.mjs",
    "native/manifest.json",
    "native/README.md",
    "native/bin/*",
    "assets/skill/SKILL.md",
    "assets/skill/manifest.json",
    "assets/skills/manifest.json",
    "assets/skills/*/SKILL.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:native": "node native/build.mjs",
    "test": "node --test test/*.test.js",
    "test:package": "node --test test/package/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "author": "Metergraph",
  "homepage": "https://www.metergraph.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metergraph/cli.git"
  },
  "bugs": {
    "url": "https://github.com/metergraph/cli/issues"
  },
  "keywords": [
    "metergraph",
    "cli",
    "llm",
    "cost-tracking"
  ],
  "publishConfig": {
    "access": "public"
  }
}
